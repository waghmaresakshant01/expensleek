{
  "version": 2,
  "buildCommand": "npm install && npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api).*)*",
      "destination": "/index.html"
    }
  ]
}
